<Window x:Class="MoneyManager.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="MoneyManager | Premium Finance"
Height="850"
Width="1350"
MinHeight="700"
MinWidth="1000"
WindowStartupLocation="CenterScreen"
Background="#0B1120"
Foreground="#F1F5F9"
FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#151F32"/>
        <SolidColorBrush x:Key="PanelLight" Color="#1D2A40"/>
        <SolidColorBrush x:Key="Stroke" Color="#2B3A52"/>
        <SolidColorBrush x:Key="Muted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Green" Color="#4ADE80"/>
        <SolidColorBrush x:Key="Red" Color="#FB7185"/>
        <SolidColorBrush x:Key="Blue" Color="#60A5FA"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BlueButton" TargetType="Button"
           BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2563EB"/>
        </Style>

        <Style x:Key="GreenButton" TargetType="Button"
           BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#166534"/>
        </Style>

        <Style x:Key="RedButton" TargetType="Button"
           BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#9F1239"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#26354B"/>
            <Setter Property="Foreground" Value="#4ADE80"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202D43"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#151F32"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#29364A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#24334A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#151F32"/>
            <Setter Property="Padding" Value="20,13"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- NAGŁÓWEK -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="MoneyManager"
                       FontSize="28"
                       FontWeight="Bold"/>

                <TextBlock Text="Centrum zarządzania finansami osobistymi"
                       Foreground="{StaticResource Muted}"
                       FontSize="12"
                       Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                Background="#142D29"
                BorderBrush="#225C49"
                BorderThickness="1"
                CornerRadius="9"
                Padding="14,10"
                VerticalAlignment="Center">
                <TextBlock Text="● PREMIUM FINANCE"
                       Foreground="#86EFAC"
                       FontSize="11"
                       FontWeight="Bold"/>
            </Border>
        </Grid>

        <!-- ZAKŁADKI -->
        <TabControl Grid.Row="1"
                Background="#0B1120"
                BorderBrush="#29364A">

            <!-- DASHBOARD -->
            <TabItem Header="⌂  Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">

                        <TextBlock Text="Twoje finanse"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,4"/>

                        <TextBlock Text="Pełny obraz Twoich pieniędzy"
                               Foreground="{StaticResource Muted}"
                               Margin="0,0,0,18"/>

                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="SALDO CAŁKOWITE"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"/>
                                    <TextBlock x:Name="BalanceText"
                                           Text="0,00 zł"
                                           FontSize="27"
                                           FontWeight="Bold"
                                           Margin="0,12,0,6"/>
                                    <TextBlock Text="Wszystkie transakcje"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="PRZYCHODY ŁĄCZNIE"
                                           Foreground="{StaticResource Green}"
                                           FontSize="11"/>
                                    <TextBlock x:Name="TotalIncomeText"
                                           Text="0,00 zł"
                                           Foreground="{StaticResource Green}"
                                           FontSize="27"
                                           FontWeight="Bold"
                                           Margin="0,12,0,6"/>
                                    <TextBlock Text="Wszystkie wpływy"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}"
                                Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="WYDATKI ŁĄCZNIE"
                                           Foreground="{StaticResource Red}"
                                           FontSize="11"/>
                                    <TextBlock x:Name="TotalExpenseText"
                                           Text="0,00 zł"
                                           Foreground="{StaticResource Red}"
                                           FontSize="27"
                                           FontWeight="Bold"
                                           Margin="0,12,0,6"/>
                                    <TextBlock Text="Wszystkie wydatki"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="PRZYCHODY W TYM MIESIĄCU"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="10"/>
                                    <TextBlock x:Name="MonthIncomeText"
                                           Text="0,00 zł"
                                           Foreground="{StaticResource Green}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="WYDATKI W TYM MIESIĄCU"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="10"/>
                                    <TextBlock x:Name="MonthExpenseText"
                                           Text="0,00 zł"
                                           Foreground="{StaticResource Red}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}"
                                Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="LICZBA TRANSAKCJI"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="10"/>
                                    <TextBlock x:Name="TransactionCountText"
                                           Text="0"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Przychody i wydatki"
                                           FontSize="17"
                                           FontWeight="Bold"/>
                                    <TextBlock Text="Ostatnie 6 miesięcy"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           Margin="0,5,0,15"/>

                                    <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,12">
                                        <Border Background="#166534"
                                            Width="10"
                                            Height="10"
                                            CornerRadius="3"
                                            Margin="0,0,6,0"/>
                                        <TextBlock Text="Przychody"
                                               FontSize="11"
                                               Margin="0,0,18,0"/>
                                        <Border Background="#BE123C"
                                            Width="10"
                                            Height="10"
                                            CornerRadius="3"
                                            Margin="0,0,6,0"/>
                                        <TextBlock Text="Wydatki"
                                               FontSize="11"/>
                                    </StackPanel>

                                    <ItemsControl x:Name="MonthlyChart">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="58"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Label}"
                                                           Foreground="#CBD5E1"
                                                           FontSize="10"/>

                                                    <StackPanel Grid.Column="1">
                                                        <ProgressBar
                                                        Value="{Binding IncomePercent}"
                                                        Maximum="100"
                                                        Height="9"
                                                        Margin="0,0,0,3"
                                                        Foreground="#4ADE80"/>
                                                        <ProgressBar
                                                        Value="{Binding ExpensePercent}"
                                                        Maximum="100"
                                                        Height="9"
                                                        Foreground="#FB7185"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                Style="{StaticResource Card}"
                                Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Wydatki według kategorii"
                                           FontSize="17"
                                           FontWeight="Bold"/>
                                    <TextBlock Text="Wybierz miesiąc do analizy"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           Margin="0,5,0,15"/>

                                    <ComboBox x:Name="ReportMonthCombo"
                                          Style="{StaticResource Combo}"
                                          SelectionChanged="ReportMonth_Changed"
                                          Margin="0,0,0,12"/>

                                    <ItemsControl x:Name="CategoryChart">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,5,0,8">
                                                    <DockPanel Margin="0,0,0,5">
                                                        <TextBlock Text="{Binding Category}"
                                                               FontSize="12"/>
                                                        <TextBlock
                                                        Text="{Binding Amount, StringFormat={}{0:N2} zł}"
                                                        FontSize="11"
                                                        Foreground="#CBD5E1"
                                                        HorizontalAlignment="Right"/>
                                                    </DockPanel>
                                                    <ProgressBar Value="{Binding Percent}"
                                                             Maximum="100"
                                                             Foreground="#818CF8"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="NoCategoryText"
                                           Text="Brak wydatków w tym miesiącu."
                                           Foreground="{StaticResource Muted}"
                                           FontSize="12"
                                           Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}"
                            Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Raport wybranego miesiąca"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Przychody"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="11"/>
                                        <TextBlock x:Name="ReportIncomeText"
                                               Text="0,00 zł"
                                               Foreground="{StaticResource Green}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="0,6,0,8"/>
                                        <ProgressBar x:Name="ReportIncomeBar"
                                                 Maximum="100"
                                                 Value="0"
                                                 Foreground="#4ADE80"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Wydatki"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="11"/>
                                        <TextBlock x:Name="ReportExpenseText"
                                               Text="0,00 zł"
                                               Foreground="{StaticResource Red}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="0,6,0,8"/>
                                        <ProgressBar x:Name="ReportExpenseBar"
                                                 Maximum="100"
                                                 Value="0"
                                                 Foreground="#FB7185"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Bilans miesiąca"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="11"/>
                                        <TextBlock x:Name="ReportBalanceText"
                                               Text="0,00 zł"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="Transakcje"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="11"/>
                                        <TextBlock x:Name="ReportCountText"
                                               Text="0"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="0,6,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- HISTORIA -->
            <TabItem Header="▤  Historia">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Historia transakcji"
                               FontSize="22"
                               FontWeight="Bold"/>
                        <TextBlock Text="Dodawaj, wyszukuj i edytuj swoje operacje finansowe."
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                        Style="{StaticResource Card}"
                        Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Wyszukiwanie i filtrowanie"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="SearchBox"
                                     Grid.Column="0"
                                     Style="{StaticResource Input}"
                                     ToolTip="Szukaj po opisie, kategorii lub kwocie"
                                     TextChanged="SearchBox_TextChanged"
                                     Margin="0,0,8,0"/>

                                <ComboBox x:Name="TypeFilterCombo"
                                      Grid.Column="1"
                                      Style="{StaticResource Combo}"
                                      SelectionChanged="Filter_Changed"
                                      Margin="0,0,8,0">
                                    <ComboBoxItem Content="Wszystkie" IsSelected="True"/>
                                    <ComboBoxItem Content="Przychód"/>
                                    <ComboBoxItem Content="Wydatek"/>
                                </ComboBox>

                                <ComboBox x:Name="CategoryFilterCombo"
                                      Grid.Column="2"
                                      Style="{StaticResource Combo}"
                                      SelectionChanged="Filter_Changed"
                                      Margin="0,0,8,0">
                                    <ComboBoxItem Content="Wszystkie" IsSelected="True"/>
                                    <ComboBoxItem Content="Inne"/>
                                    <ComboBoxItem Content="Jedzenie"/>
                                    <ComboBoxItem Content="Transport"/>
                                    <ComboBoxItem Content="Mieszkanie"/>
                                    <ComboBoxItem Content="Rozrywka"/>
                                    <ComboBoxItem Content="Zdrowie"/>
                                    <ComboBoxItem Content="Wynagrodzenie"/>
                                    <ComboBoxItem Content="Zakupy"/>
                                    <ComboBoxItem Content="Rachunki"/>
                                    <ComboBoxItem Content="Edukacja"/>
                                    <ComboBoxItem Content="Oszczędności"/>
                                </ComboBox>

                                <ComboBox x:Name="MonthFilterCombo"
                                      Grid.Column="3"
                                      Style="{StaticResource Combo}"
                                      SelectionChanged="Filter_Changed"/>
                            </Grid>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Wyczyść filtry"
                                    Style="{StaticResource ActionButton}"
                                    Click="ClearFilters_Click"/>
                                <Button Content="Odśwież"
                                    Style="{StaticResource ActionButton}"
                                    Click="Refresh_Click"/>
                                <Button Content="Edytuj zaznaczoną"
                                    Style="{StaticResource BlueButton}"
                                    Click="EditTransaction_Click"/>
                                <Button Content="Usuń zaznaczoną"
                                    Style="{StaticResource RedButton}"
                                    Margin="0"
                                    Click="Delete_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- FORMULARZ -->
                    <Border Grid.Row="2"
                        Style="{StaticResource Card}"
                        Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="TransactionFormTitle"
                                   Text="Nowa transakcja"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Rodzaj"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                    <ComboBox x:Name="TypeCombo"
                                          Style="{StaticResource Combo}"
                                          SelectedIndex="1">
                                        <ComboBoxItem Content="Przychód"/>
                                        <ComboBoxItem Content="Wydatek"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Kategoria"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CategoryCombo"
                                          Style="{StaticResource Combo}"
                                          SelectedIndex="0">
                                        <ComboBoxItem Content="Inne"/>
                                        <ComboBoxItem Content="Jedzenie"/>
                                        <ComboBoxItem Content="Transport"/>
                                        <ComboBoxItem Content="Mieszkanie"/>
                                        <ComboBoxItem Content="Rozrywka"/>
                                        <ComboBoxItem Content="Zdrowie"/>
                                        <ComboBoxItem Content="Wynagrodzenie"/>
                                        <ComboBoxItem Content="Zakupy"/>
                                        <ComboBoxItem Content="Rachunki"/>
                                        <ComboBoxItem Content="Edukacja"/>
                                        <ComboBoxItem Content="Oszczędności"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="Kwota (zł)"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                    <TextBox x:Name="AmountBox"
                                         Text="10,00"
                                         Style="{StaticResource Input}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Opis"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                    <TextBox x:Name="DescriptionBox"
                                         Style="{StaticResource Input}"
                                         ToolTip="Np. zakupy spożywcze"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="SaveTransactionButton"
                                    Content="Dodaj transakcję"
                                    Style="{StaticResource BlueButton}"
                                    Click="AddSelectedTransaction_Click"/>
                                <Button Content="+ 1 zł"
                                    Style="{StaticResource ActionButton}"
                                    Click="IncreaseAmount_Click"/>
                                <Button Content="− 1 zł"
                                    Style="{StaticResource ActionButton}"
                                    Click="DecreaseAmount_Click"/>
                                <Button Content="Szybki przychód"
                                    Style="{StaticResource GreenButton}"
                                    Click="AddIncome_Click"/>
                                <Button Content="Szybki wydatek"
                                    Style="{StaticResource RedButton}"
                                    Click="AddExpense_Click"/>
                                <Button x:Name="CancelEditButton"
                                    Content="Anuluj edycję"
                                    Style="{StaticResource ActionButton}"
                                    Visibility="Collapsed"
                                    Margin="0"
                                    Click="CancelEdit_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- TABELA TRANSAKCJI -->
                    <DataGrid x:Name="TransactionsGrid"
                          Grid.Row="3"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="#151F32"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          CanUserResizeRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data"
                                            Binding="{Binding DateDisplay}"
                                            Width="145"/>
                            <DataGridTextColumn Header="Rodzaj"
                                            Binding="{Binding Type}"
                                            Width="110"/>
                            <DataGridTextColumn Header="Kategoria"
                                            Binding="{Binding Category}"
                                            Width="130"/>
                            <DataGridTextColumn Header="Opis"
                                            Binding="{Binding Description}"
                                            Width="*"
                                            MinWidth="150"/>
                            <DataGridTextColumn Header="Kwota"
                                            Binding="{Binding AmountDisplay}"
                                            Width="155">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Przychód">
                                                <Setter Property="Foreground" Value="#4ADE80"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Wydatek">
                                                <Setter Property="Foreground" Value="#FB7185"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="4"
                           x:Name="FilterResultText"
                           Text="Wyświetlane transakcje: 0"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <!-- BUDŻETY -->
            <TabItem Header="◈  Budżety">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Budżety i limity wydatków"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                        <TextBlock Text="Kontroluj wydatki w poszczególnych kategoriach."
                               Foreground="{StaticResource Muted}"
                               Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Dodaj lub zmień limit miesięczny"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Kategoria"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="11"
                                               Margin="0,0,0,6"/>
                                        <ComboBox x:Name="BudgetCategoryCombo"
                                              Style="{StaticResource Combo}">
                                            <ComboBoxItem Content="Inne" IsSelected="True"/>
                                            <ComboBoxItem Content="Jedzenie"/>
                                            <ComboBoxItem Content="Transport"/>
                                            <ComboBoxItem Content="Mieszkanie"/>
                                            <ComboBoxItem Content="Rozrywka"/>
                                            <ComboBoxItem Content="Zdrowie"/>
                                            <ComboBoxItem Content="Zakupy"/>
                                            <ComboBoxItem Content="Rachunki"/>
                                            <ComboBoxItem Content="Edukacja"/>
                                            <ComboBoxItem Content="Oszczędności"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="Limit miesięczny (zł)"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="11"
                                               Margin="0,0,0,6"/>
                                        <TextBox x:Name="BudgetLimitBox"
                                             Style="{StaticResource Input}"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                        Content="Zapisz limit"
                                        Style="{StaticResource BlueButton}"
                                        VerticalAlignment="Bottom"
                                        Margin="0"
                                        Click="AddBudget_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Wykorzystanie budżetów"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>

                                <TextBlock x:Name="BudgetSummaryText"
                                       Text="Wykorzystano 0,00 zł z 0,00 zł"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,0,0,10"/>

                                <ProgressBar x:Name="BudgetSummaryBar"
                                         Maximum="100"
                                         Value="0"
                                         Height="12"
                                         Margin="0,0,0,12"/>

                                <DataGrid x:Name="BudgetsGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="#151F32"
                                      BorderThickness="0"
                                      RowHeaderWidth="0"
                                      MinHeight="180"
                                      MaxHeight="350">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kategoria"
                                                        Binding="{Binding Category}"
                                                        Width="*"/>
                                        <DataGridTextColumn Header="Limit"
                                                        Binding="{Binding MonthlyLimit, StringFormat={}{0:N2} zł}"
                                                        Width="140"/>
                                        <DataGridTextColumn Header="Wydano"
                                                        Binding="{Binding Spent, StringFormat={}{0:N2} zł}"
                                                        Width="140"/>
                                        <DataGridTemplateColumn Header="Postęp" Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ProgressBar Value="{Binding Percent}"
                                                             Maximum="100"
                                                             Height="9"
                                                             VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Status"
                                                        Binding="{Binding Status}"
                                                        Width="160"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Button Content="Usuń zaznaczony budżet"
                                    Style="{StaticResource RedButton}"
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    Click="DeleteBudget_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Wydatki są porównywane z limitami dla wybranego miesiąca."
                               Foreground="{StaticResource Muted}"
                               FontSize="11"
                               Margin="2,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- STOPKA -->
        <TextBlock Grid.Row="2"
               Text="MoneyManager • Premium Dark • Dane przechowywane lokalnie"
               Foreground="#64748B"
               FontSize="10"
               HorizontalAlignment="Center"
               Margin="0,12,0,0"/>
    </Grid>


</Window>
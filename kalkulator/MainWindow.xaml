<Window x:Class="Kalkulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalkulator"
        Height="600"
        Width="360"
        MinHeight="550"
        MinWidth="340"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#17191F">

    <Window.Resources>

        <Style x:Key="NumberButton" TargetType="Button">
            <Setter Property="Background" Value="#30343E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="FunctionButton"
               TargetType="Button"
               BasedOn="{StaticResource NumberButton}">
            <Setter Property="Background" Value="#505563"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="OperatorButton"
               TargetType="Button"
               BasedOn="{StaticResource NumberButton}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="#17191F"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="EqualsButton"
               TargetType="Button"
               BasedOn="{StaticResource NumberButton}">
            <Setter Property="Background" Value="#22C55E"/>
            <Setter Property="Foreground" Value="#101810"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- WYŚWIETLACZ -->
        <Border Grid.Row="0"
                Background="#22252D"
                CornerRadius="12"
                Margin="0,0,0,10">

            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="KALKULATOR"
                           Foreground="#A0A6B5"
                           FontSize="13"
                           FontWeight="Bold"/>

                <TextBlock x:Name="Display"
                           Grid.Row="1"
                           Text="0"
                           Foreground="White"
                           FontSize="38"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- KLAWIATURA -->
        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Rows="5">

            <Button Content="C"
                    Click="Clear_Click"
                    Style="{StaticResource FunctionButton}"/>

            <Button Content="±"
                    Click="Sign_Click"
                    Style="{StaticResource FunctionButton}"/>

            <Button Content="⌫"
                    Click="Backspace_Click"
                    Style="{StaticResource FunctionButton}"/>

            <Button Content="÷"
                    Tag="/"
                    Click="Operation_Click"
                    Style="{StaticResource OperatorButton}"/>

            <Button Content="7"
                    Click="Number_Click"
                    Style="{StaticResource NumberButton}"/>

            <Button Content="8"
                    Click="Number_Click"
                    Style="{StaticResource NumberButton}"/>

            <Button Content="9"
                    Click="Number_Click"
                    Style="{StaticResource NumberButton}"/>

            <Button Content="×"
                    Tag="*"
                    Click="Operation_Click"
                    Style="{StaticResource OperatorButton}"/>

            <Button Content="4"
                    Click="Number_Click"
                    Style="{StaticResource NumberButton}"/>

            <Button Content="5"
                    Click="Number_Click"
                    Style="{StaticResource NumberButton}"/>

            <Button Content="6"
                    Click="Number_Click"
                    Style="{StaticResource NumberButton}"/>

            <Button Content="−"
                    Tag="-"
                    Click="Operation_Click"
                    Style="{StaticResource OperatorButton}"/>

            <Button Content="1"
                    Click="Number_Click"
                    Style="{StaticResource NumberButton}"/>

            <Button Content="2"
                    Click="Number_Click"
                    Style="{StaticResource NumberButton}"/>

            <Button Content="3"
                    Click="Number_Click"
                    Style="{StaticResource NumberButton}"/>

            <Button Content="+"
                    Tag="+"
                    Click="Operation_Click"
                    Style="{StaticResource OperatorButton}"/>

            <Button Content="0"
                    Click="Number_Click"
                    Style="{StaticResource NumberButton}"/>

            <Button Content=","
                    Click="Decimal_Click"
                    Style="{StaticResource NumberButton}"/>

            <Button Content="="
                    Click="Equals_Click"
                    Style="{StaticResource EqualsButton}"/>

        </UniformGrid>
    </Grid>
</Window>